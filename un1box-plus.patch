new file mode 100755
index 0000000..0754a10
--- /dev/null
+++ b/tools/export-from-original.sh
@@ -0,0 +1,28 @@
+#!/bin/sh
+# Copies the original Un1box's device library off a phone, ready for Un1box Plus > Settings > Import from Un1box.
+#
+# Android keeps each app's files private, so this needs one of:
+#   - the original is a debuggable build (run-as works), or
+#   - the phone is rooted (su works).
+# Neither? Build Un1box Plus with -PreplaceOriginal=true instead and install it over the original
+# (same signing key required): the devices are then already there, nothing to copy.
+#
+# Usage: tools/export-from-original.sh [OUT_DIR]      (default: ./un1box-library)
+#        then copy OUT_DIR to the phone and pick it in Un1box Plus.
+# Stop any running device in the original first, so its storage is not copied mid-write.
+set -eu
+PKG="${ORIGINAL_PACKAGE:-org.un1box.android}"
+OUT="${1:-un1box-library}"
+command -v adb >/dev/null || { echo "adb not found" >&2; exit 1; }
+mkdir -p "$OUT"
+if adb exec-out run-as "$PKG" tar -C files -cf - library 2>/dev/null | tar -xf - -C "$OUT" 2>/dev/null && [ -d "$OUT/library/records" ]; then
+  echo "Copied with run-as."
+elif adb exec-out su -c "tar -C /data/data/$PKG/files -cf - library" 2>/dev/null | tar -xf - -C "$OUT" 2>/dev/null && [ -d "$OUT/library/records" ]; then
+  echo "Copied with root."
+else
+  echo "Could not read $PKG's files (not debuggable, no root). See the note at the top of this script." >&2
+  exit 1
+fi
+echo "Library is in $OUT/library. Push it to the phone, e.g.:"
+echo "  adb push $OUT/library /sdcard/Download/un1box-library"
+echo "then in Un1box Plus: Settings > Import from Un1box > pick that folder."
