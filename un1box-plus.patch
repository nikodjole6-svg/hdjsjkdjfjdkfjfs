new file mode 100644
index 0000000..9904387
--- /dev/null
+++ b/Android/app/src/main/java/org/un1box/android/DeviceTransfer.kt
@@ -0,0 +1,134 @@
+package org.un1box.android
+
+import android.content.Context
+import android.net.Uri
+import android.system.Os
+import androidx.documentfile.provider.DocumentFile
+import org.json.JSONObject
+import java.io.File
+import java.io.IOException
+import java.io.RandomAccessFile
+
+/**
+ * Un1box Plus: moves saved devices, with their own storage, across from the original Un1box.
+ *
+ * Android keeps each app's files private, so Plus cannot reach into the original. What it can read is a
+ * copy of the original's `library` folder that the person has put somewhere it can see (tools/export-from-original.sh
+ * makes one over adb). The folder is read through the system picker, one device record at a time:
+ *
+ *  - a record is `records/<id>/{record.json, base/, state/, assets/}`, exactly what the engine's library keeps;
+ *  - each is copied into a hidden staging folder (the engine ignores dot-folders), checked, and only then renamed
+ *    into place, so a failed or cancelled transfer never leaves a half-device in the list;
+ *  - a record whose id is already here is skipped, so running the transfer twice is harmless;
+ *  - zero blocks are not written, so a mostly empty flash image stays as small as it was on the original.
+ */
+internal object DeviceTransfer {
+    /** What one transfer did, in the words Settings shows. */
+    data class Report(val imported: List<String>, val alreadyHere: Int, val failed: List<String>) {
+        val summary: String get() = buildString {
+            append(when (imported.size) { 0 -> "Nothing new to import"; 1 -> "Imported ${imported[0]}"; else -> "Imported ${imported.size} devices" })
+            if (alreadyHere > 0) append(" · $alreadyHere already here")
+            if (failed.isNotEmpty()) append(" · ${failed.size} failed: ${failed.first()}")
+        }
+    }
+
+    private const val CHUNK = 1 shl 16
+    private val ID = Regex("[A-Za-z0-9_-]{1,63}")
+    private const val STAGE_PREFIX = ".record-stage-import-"
+
+    /** The record folders inside whatever the person picked: a library, its `records` folder, or one record. */
+    fun findRecords(picked: DocumentFile): List<DocumentFile> {
+        if (picked.findFile("record.json")?.isFile == true) return listOf(picked)
+        val records = if (picked.name == "records") picked else picked.findFile("records")?.takeIf { it.isDirectory }
+        return records?.listFiles()?.filter { it.isDirectory && it.name?.let { n -> ID.matches(n) } == true && it.findFile("record.json")?.isFile == true }
+            ?.sortedBy { it.name } ?: emptyList()
+    }
+
+    private fun safeName(name: String?): String? =
+        name?.takeIf { it.isNotEmpty() && it != "." && it != ".." && '/' !in it && '\u0000' !in it && '\\' !in it }
+
+    private fun sizeOf(entry: DocumentFile): Long =
+        if (entry.isDirectory) entry.listFiles().sumOf { sizeOf(it) } else entry.length()
+
+    /** Reads `record.json` and refuses anything the engine would: another schema, an id that is not the folder's name. */
+    internal fun validate(json: String, folder: String): JSONObject {
+        val record = JSONObject(json)
+        require(record.optInt("schema") == 1) { "unsupported record schema" }
+        require(record.optString("id") == folder && ID.matches(folder)) { "record id does not match its folder" }
+        require(record.optString("name").isNotEmpty() && record.optString("board").isNotEmpty() && record.optString("build").isNotEmpty()) { "record is incomplete" }
+        return record
+    }
+
+    /** Copies one file, leaving the all-zero blocks as holes so a sparse image keeps its small footprint. */
+    private fun copyFile(context: Context, source: DocumentFile, target: File, onBytes: (Long) -> Unit) {
+        val buffer = ByteArray(CHUNK)
+        context.contentResolver.openInputStream(source.uri)?.use { input ->
+            RandomAccessFile(target, "rw").use { output ->
+                var position = 0L
+                while (true) {
+                    val n = input.read(buffer)
+                    if (n < 0) break
+                    if (!allZero(buffer, n)) { output.seek(position); output.write(buffer, 0, n) }
+                    position += n
+                    onBytes(n.toLong())
+                }
+                output.setLength(position)
+            }
+        } ?: throw IOException("Cannot read ${source.name}")
+    }
+
+    private fun allZero(b: ByteArray, n: Int): Boolean { for (i in 0 until n) if (b[i].toInt() != 0) return false; return true }
+
+    private fun copyTree(context: Context, source: DocumentFile, target: File, onBytes: (Long) -> Unit) {
+        target.mkdirs()
+        for (child in source.listFiles()) {
+            val name = safeName(child.name) ?: throw IOException("Refusing an unsafe file name in ${source.name}")
+            val out = File(target, name)
+            if (child.isDirectory) copyTree(context, child, out, onBytes) else copyFile(context, child, out, onBytes)
+        }
+    }
+
+    /**
+     * Imports every record found under [picked]. [existing] holds the ids already in this library.
+     * Runs on the caller's thread (do not call from the UI thread); [progress] gets a label and 0..1 (or -1 when unknown).
+     */
+    fun import(context: Context, picked: Uri, existing: Set<String>, progress: (String, Float) -> Unit): Report {
+        val root = DocumentFile.fromTreeUri(context, picked) ?: throw IOException("Cannot open that folder")
+        val records = findRecords(root)
+        require(records.isNotEmpty()) { "No Un1box devices found there. Pick the original's library folder (it contains a records folder)." }
+        val library = File(context.filesDir, "library")
+        val destination = File(library, "records").apply { mkdirs() }
+        destination.listFiles { f -> f.name.startsWith(STAGE_PREFIX) }?.forEach { it.deleteRecursively() } // a crashed earlier run
+
+        val imported = mutableListOf<String>(); val failed = mutableListOf<String>(); var already = 0
+        val total = records.filter { it.name !in existing }.sumOf { sizeOf(it) }.coerceAtLeast(1L); var done = 0L
+        for (record in records) {
+            val id = record.name ?: continue
+            if (id in existing || File(destination, id).exists()) { already++; continue }
+            val stage = File(destination, STAGE_PREFIX + System.nanoTime())
+            var label = id
+            try {
+                val meta = validate(context.contentResolver.openInputStream(record.findFile("record.json")!!.uri)?.use { it.readBytes().toString(Charsets.UTF_8) }
+                    ?: throw IOException("Cannot read record.json"), id)
+                label = meta.getString("name")
+                require(record.findFile("base")?.findFile("device.lock.json")?.isFile == true) { "the system image is missing" }
+                copyTree(context, record, stage) { n -> done += n; progress("Importing $label…", (done.toFloat() / total).coerceAtMost(1f)) }
+                // The engine seals a record's assets read-only; do the same once they are all in.
+                File(stage, "assets").takeIf { it.isDirectory }?.let { Os.chmod(it.path, 0b101_000_000) }
+                if (!stage.renameTo(File(destination, id))) throw IOException("Could not place $label in the library")
+                imported += label
+            } catch (e: Exception) {
+                File(stage, "assets").takeIf { it.exists() }?.let { runCatching { Os.chmod(it.path, 0b111_000_000) } }
+                stage.deleteRecursively()
+                failed += "$label (${e.message ?: e.javaClass.simpleName})"
+            }
+        }
+        // First devices in an empty library become the selected one, as the engine's own import does.
+        val selected = File(library, "selected")
+        if (imported.isNotEmpty() && !selected.exists()) {
+            val first = destination.listFiles { f -> !f.name.startsWith(".") && f.isDirectory }?.minOfOrNull { it.name }
+            if (first != null) { val tmp = File(library, "selected.import"); tmp.writeText(first); tmp.renameTo(selected) }
+        }
+        return Report(imported, already, failed)
+    }
+}
