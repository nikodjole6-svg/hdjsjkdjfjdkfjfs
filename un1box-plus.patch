+
+class DeviceTransferTest {
+    @Test fun summaryNamesWhatHappened() {
+        assertEquals("Nothing new to import", DeviceTransfer.Report(emptyList(), 0, emptyList()).summary)
+        assertEquals("Imported iPod touch 2G", DeviceTransfer.Report(listOf("iPod touch 2G"), 0, emptyList()).summary)
